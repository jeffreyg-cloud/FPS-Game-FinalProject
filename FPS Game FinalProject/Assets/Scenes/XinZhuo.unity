  m_Script: {fileID: 11500000, guid: 3486c83b95be55d49b7e64a9a2619506, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BookReader
  bookPanel: {fileID: 11221582}
  bookPrompt: {fileID: 886279709}
  titleText: {fileID: 710101721}
  storyText: {fileID: 1459113383}
  bookTitle: The Shifting Mushroom Forest
  story: 'Deep inside Wonderland, there was a magical forest where mushrooms changed
    their positions every night.



    The paths would disappear and new roads would
    appear, making the forest impossible to map.



    Many travelers became lost
    there, but some discovered that the forest was not trying to trap them.



    The
    mushrooms were guiding visitors toward hidden places by creating paths only for
    those who truly wanted to explore.



    It was believed that the forest could
    understand the hearts of travelers and reveal its secrets to those with curiosity
    and courage.'
