  m_Script: {fileID: 11500000, guid: 3486c83b95be55d49b7e64a9a2619506, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BookReader
  bookPanel: {fileID: 11221582}
  bookPrompt: {fileID: 886279709}
  titleText: {fileID: 710101721}
  storyText: {fileID: 1459113383}
  bookTitle: The Forgotten Tea Party
  story: 'Long ago, in a quiet corner of Wonderland, there was a mysterious tea party
    that nobody remembered.



    The tables were always prepared with endless cups
    of tea and colorful cakes, but no guests ever arrived.



    Some said the party
    was waiting for travelers who had lost their way, while others believed it was
    created to preserve the happiest memories of Wonderland.



    Every night,
    the empty chairs moved by themselves, as if invisible guests were still enjoying
    the forgotten celebration.



    Those who discovered the tea party learned
    that happiness does not disappear. It only waits for someone to remember it.'
